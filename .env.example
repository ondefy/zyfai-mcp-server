# MCP Server Configuration
# Copy this file to .env and update with your values

# Partner SDK key — required for live tool calls (not the env-prefixed integration names).
# Local: paste the value of LOCAL_ZYFAI_API_KEY from ../zyfai-sdk/.env.test here.
ZYFAI_API_KEY=your_api_key_here

# --- Local workspace dev (pnpm dev:zyfai-mcp or pnpm dev:mcp) ---
# Requires zyfai-api on :3000 — from workspace root: pnpm dev:zyfai-api (or pnpm dev:mcp).
# MCP only wraps the SDK; it does not start the execution API.
# ZYFAI_BACKEND_ENV=local
# ZYFAI_EXECUTION_API_URL=http://localhost:3000
# ZYFAI_DATA_API_URL=https://staging-defiapi.zyf.ai

# --- Integration tests (pnpm run test:integration) ---
# Uses env.test.example → .env.test (ZYFAI_ENV, LOCAL_ZYFAI_API_KEY, optional URL overrides).
# Not read from this .env file unless you duplicate those values here.

# Backend stack for SDK calls when unset above (omit entirely for production URLs)
# ZYFAI_BACKEND_ENV=staging

# Server Configuration
PORT=3005
HOST=0.0.0.0

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=*

# MCP OAuth (set MCP_AUTH_REQUIRED=true in production)
MCP_AUTH_REQUIRED=false
MCP_RESOURCE_URL=https://mcp.zyf.ai
MCP_OAUTH_JWT_SECRET=must_match_zyfai_api_MCP_OAUTH_JWT_SECRET
MCP_OAUTH_ISSUER=https://api.zyf.ai
