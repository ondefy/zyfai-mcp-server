# Integration tests ONLY — copy to .env.test (gitignored)
# Do NOT copy .env or .env.example here (PORT / MCP_* belong in .env for dev:watch).
#
# Vitest merges ../zyfai-sdk/.env.test first, then this file (this file wins on conflicts).
# Easiest path: keep keys only in zyfai-sdk/.env.test and set ZYFAI_ENV here if you want local.

ZYFAI_ENV=local

# Partner key for the active ZYFAI_ENV (same names as zyfai-sdk integration tests)
LOCAL_ZYFAI_API_KEY=
STAGING_ZYFAI_API_KEY=
PRODUCTION_ZYFAI_API_KEY=

# Optional fallbacks
# ZYFAI_API_KEY=

# Local hybrid stack (execution on :3000, data on staging — typical workspace setup)
ZYFAI_EXECUTION_API_URL=http://localhost:3000
ZYFAI_DATA_API_URL=https://staging-defiapi.zyf.ai

# Optional: hit dev:watch on :3005 instead of in-process createApp()
# MCP_INTEGRATION_BASE_URL=http://127.0.0.1:3005

# Future OAuth / agent suites (credentialGate: persistent_wallet)
# PRIVATE_KEY=0x...
