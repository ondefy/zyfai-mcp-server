{
  "name": "zyfai-mcp-server",
  "version": "0.0.2",
  "main": "build/index.js",
  "keywords": [
    "mcp",
    "zyfai",
    "rebalancing",
    "defi",
    "erc-8004"
  ],
  "author": "",
  "license": "ISC",
  "description": "Zyfai DeFi MCP Server with Streamable HTTP transport",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@zyfai/sdk": "^0.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "viem": "^2.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.19.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && pnpm run build",
    "test:integration": "sh -c 'if [ -n \"$1\" ]; then vitest run src/integration/$1.integration.test.ts --fileParallelism=false; else vitest run src/integration --fileParallelism=false; fi' --",
    "test:integration:local": "ZYFAI_ENV=local pnpm dlx wait-on tcp:127.0.0.1:3000 -t 120000 -l && pnpm run test:integration",
    "build": "tsc",
    "start": "node build/index.js",
    "start:stdio": "node build/index-stdio.js",
    "dev": "tsc && node build/index.js",
    "dev:watch": "sh scripts/dev-watch.sh",
    "clean": "rm -rf build"
  }
}
